# --- Meeting → tasks pipeline (CSAAS integration) ---
MEETING_PIPELINE_ENABLED=true
MEETING_REPORTS_DIR=bot/meeting-reports
MEETING_STAGE_TIMEOUT_MS=360000
CSAAS_API_URL=http://127.0.0.1:3000/api
# CSAAS URDD id holding: add_meetings + run_meeting_ai + update_meetings + view_meetings
CSAAS_ACTOR_URDD=
# Per-request hard timeout for CSAAS calls (ms). A timed-out request is aborted.
CSAAS_REQUEST_TIMEOUT_MS=300000
